# ══════════════════════════════════════════════════════════
# CEO Digital Twin — .gitignore
# ══════════════════════════════════════════════════════════

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/

# Secrets — NEVER commit these
.env
*.env
# .env.example is safe to commit (no real keys)
!.env.example

# ── Data we DO want in git (via LFS for large files) ──────────
# DO NOT gitignore these — they must be in the HF repo for the
# Space to function. LFS handles the size.
# data/vector_store/    ← TRACKED via LFS
# data/*.db             ← TRACKED via LFS
# data/*.pkl            ← TRACKED via LFS
# data/govind_persona.json ← TRACKED (not sensitive)

# ── Raw source data (NOT needed in HF Space) ──────────────────
data/oldjson/
data/jsons/

# ── Ephemeral data (regenerated at runtime) ──────────────────
data/memory_store/
data/sessions.db
logs/

# Phase 2 source material (large, not needed in Space)
phase2txt/
instructions.txt

# Node / Frontend (built separately on Vercel)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env

# OS / IDEs
.DS_Store
.vscode/
.idea/
Thumbs.db